<?xml version="1.0" encoding="utf-8"?>
<!--
https://go.microsoft.com/fwlink/?LinkID=208121.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <LauncherDistributionDir>$(MSBuildProjectDirectory)\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\</LauncherDistributionDir>
    <PublishDir>$(LauncherDistributionDir)</PublishDir>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- Compression and trimming reduce the self-contained single EXE from about
         71.4 MB to 37.6 MB on the current toolchain. Keep startup and update/archive
         smoke tests in the release verification loop. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Current CsWinRT sources suppress this warning for ABI types because those
         types never have constructors. Keep every other trim warning visible. -->
    <NoWarn>$(NoWarn);IL2081</NoWarn>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <Target Name="CleanReleaseDistributionDirectory"
          AfterTargets="PrepareForPublish"
          Condition="'$([MSBuild]::NormalizeDirectory($(PublishDir)))' == '$([MSBuild]::NormalizeDirectory($(LauncherDistributionDir)))'">
    <RemoveDir Directories="$(PublishDir)" Condition="Exists('$(PublishDir)')" />
    <MakeDir Directories="$(PublishDir)" />
  </Target>
</Project>
