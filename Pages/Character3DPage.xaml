<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="TaikoDiveLauncher.Pages.Character3DPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="20" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="4">
   <Button Content="← プロフィールに戻る" Click="BackToProfile_Click" HorizontalAlignment="Left" />
   <TextBlock Text="どんちゃんの着せ替え" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap"/>
   <TextBlock Text="ユーザー別に3Dキャラの衣装と色を変更します。次回のゲーム起動から反映されます。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
   <CommandBar HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right">
    <AppBarButton x:Name="SaveButton" Icon="Save" Label="保存" Click="Save_Click" Style="{StaticResource VisibleAppBarButtonStyle}"/>
    <AppBarButton Icon="Refresh" Label="保存済みに戻す" Click="Reload_Click" Style="{StaticResource VisibleAppBarButtonStyle}"/>
    <CommandBar.SecondaryCommands>
     <AppBarButton Icon="Undo" Label="1つ前の保存を復元" Click="RestorePrevious_Click"/>
    </CommandBar.SecondaryCommands>
   </CommandBar>
  </StackPanel>
  <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
  <ComboBox x:Name="UserBox" Grid.Row="2" Header="設定するユーザー" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="UserChanged"/>
  <Grid Grid.Row="3" ColumnSpacing="24" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="*"/><RowDefinition x:Name="EditorRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="PreviewPanel" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Spacing="8">
     <ToggleSwitch x:Name="AnimationSwitch" Header="アニメーション" IsOn="False" Toggled="AnimationModeChanged"/>
     <ComboBox x:Name="AnimationBox" Header="再生する動き" IsEnabled="False" HorizontalAlignment="Stretch" SelectionChanged="AnimationChanged"/>
    </StackPanel>
    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
     <Grid>
      <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="選択した衣装と配色の3Dプレビュー"/>
      <ProgressRing x:Name="PreviewBusy" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" Spacing="6">
     <TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="PlaybackButton" Content="一時停止" Click="Playback_Click" IsEnabled="False" Visibility="Collapsed"/>
      <Button Content="プレビューを更新" Click="Preview_Click"/>
     </StackPanel>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="Editor" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="0,0,8,16">
     <TextBlock Text="衣装" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <ToggleSwitch x:Name="CostumeSwitch" Header="全身きぐるみを使用" Toggled="ModeChanged"/>
    <ComboBox x:Name="HeadBox" Header="あたま" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="PartChanged"/>
    <ComboBox x:Name="BodyBox" Header="からだ" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="PartChanged"/>
    <ComboBox x:Name="CostumeBox" Header="全身きぐるみ" HorizontalAlignment="Stretch" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="PartChanged"/>
    <StackPanel Orientation="Horizontal" Spacing="12">
     <Image x:Name="HeadIcon" Width="80" Height="80" AutomationProperties.Name="あたまの衣装アイコン"/>
     <Image x:Name="BodyIcon" Width="80" Height="80" AutomationProperties.Name="からだの衣装アイコン"/>
     <Image x:Name="CostumeIcon" Width="80" Height="80" AutomationProperties.Name="全身きぐるみのアイコン"/>
    </StackPanel>
    <TextBlock Text="部位ごとの色" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <Button x:Name="BodyColorButton" Tag="body" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="LimbsColorButton" Tag="limbs" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="FaceColorButton" Tag="face" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="RimColorButton" Tag="rim" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button Content="色を標準に戻す" Click="ResetColors_Click"/>
    <TextBlock Text="衣装固有の模様や目・口の色は変わりません。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Expander Header="モデルの参照先" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="12">
       <TextBox x:Name="ModelsPathBox" Header="配置済みのモデルフォルダー" TextChanged="Changed"/>
       <Button Content="衣装一覧を読み直す" Click="ReadCatalog_Click"/>
       <TextBlock Text="既存のモデルをそのまま参照します。コピーやインストールは行いません。参照先は共通設定で変更できます。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Expander>
     <TextBlock Text="個別に保存していないユーザーには共通設定が適用されます。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </ScrollViewer>
   <VisualStateManager.VisualStateGroups>
    <VisualStateGroup>
     <VisualState x:Name="Wide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000"/></VisualState.StateTriggers></VisualState>
     <VisualState x:Name="Narrow">
      <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
      <VisualState.Setters>
       <Setter Target="PreviewColumn.Width" Value="*"/><Setter Target="EditorColumn.Width" Value="0"/>
       <Setter Target="PreviewRow.Height" Value="260"/><Setter Target="EditorRow.Height" Value="*"/>
       <Setter Target="Editor.(Grid.Column)" Value="0"/><Setter Target="Editor.(Grid.Row)" Value="1"/>
      </VisualState.Setters>
     </VisualState>
    </VisualStateGroup>
   </VisualStateManager.VisualStateGroups>
  </Grid>
 </Grid>
</Page>
