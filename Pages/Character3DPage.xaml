<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="TaikoDiveLauncher.Pages.Character3DPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Style="{StaticResource PageLayoutStyle}" x:Name="PageRoot" SizeChanged="PageRoot_SizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12" RowSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="4">
    <TextBlock Text="どんちゃんの着せ替え" Style="{StaticResource PageTitleStyle}" TextWrapping="Wrap"/>
    <TextBlock Text="ユーザー別に3Dキャラの衣装・色・ぷちキャラを変更します。次回のゲーム起動から反映されます。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
    <TextBlock x:Name="EditStateText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <CommandBar x:Name="CharacterCommandBar" Grid.Column="1" Style="{StaticResource PageCommandBarStyle}">
    <AppBarButton Icon="Back" Label="プロフィールへ" Click="BackToProfile_Click" Style="{StaticResource VisibleAppBarButtonStyle}"/>
    <AppBarButton x:Name="SaveButton" Icon="Save" Label="保存" Click="Save_Click" Style="{StaticResource VisibleAppBarButtonStyle}"/>
    <CommandBar.SecondaryCommands>
    <AppBarButton Label="コーデ保存・共有" Click="Outfits_Click" />
     <AppBarButton Icon="Refresh" Label="保存済みに戻す" Click="Reload_Click"/>
     <AppBarButton Icon="Undo" Label="1つ前の保存を復元" Click="RestorePrevious_Click"/>
    </CommandBar.SecondaryCommands>
   </CommandBar>
  </Grid>
  <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
  <StackPanel x:Name="ModePicker" Grid.Row="2" Spacing="16">
   <TextBlock Text="着せ替え方を選択" Style="{StaticResource SectionTitleStyle}"/>
   <Button x:Name="PartsModeButton" Tag="parts" Click="ChooseMode_Click" Style="{StaticResource EditorNavigationButtonStyle}" AutomationProperties.Name="パーツ別に着せ替える">
    <StackPanel Spacing="4"><TextBlock Text="パーツ別に着せ替える" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="あたま・からだを組み合わせて編集" TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
   </Button>
   <Button x:Name="CostumeModeButton" Tag="costume" Click="ChooseMode_Click" Style="{StaticResource EditorNavigationButtonStyle}" AutomationProperties.Name="全身着ぐるみを選ぶ">
    <StackPanel Spacing="4"><TextBlock Text="全身着ぐるみを選ぶ" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="全身の衣装をまとめて変更" TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
   </Button>
  </StackPanel>
  <Button x:Name="ChangeModeButton" Grid.Row="2" Content="着せ替え方を選び直す" Click="ChangeMode_Click" Visibility="Collapsed"/>
  <ScrollViewer x:Name="ContentScroller" Visibility="Collapsed" Grid.Row="3" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
  <Grid ColumnSpacing="24" RowSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="PreviewColumn" Width="*"/><ColumnDefinition x:Name="EditorColumn" Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="PreviewRow" Height="*"/><RowDefinition x:Name="EditorRow" Height="0"/></Grid.RowDefinitions>
   <Grid x:Name="PreviewPanel" RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ComboBox x:Name="FacingBox" Header="プレビューの向き" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="FacingChanged">
     <ComboBoxItem Content="1P側"/><ComboBoxItem Content="2P側"/>
    </ComboBox>
    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
     <Grid>
      <Image x:Name="PreviewImage" Stretch="Uniform" AutomationProperties.Name="選択した衣装と配色の3Dプレビュー"/>
      <ProgressRing x:Name="PreviewBusy" Width="32" Height="32" IsActive="False" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <StackPanel Grid.Row="2" Spacing="6">
     <TextBlock x:Name="PreviewStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="プレビューを更新" Click="Preview_Click"/>
     </StackPanel>
    </StackPanel>
   </Grid>
   <ScrollViewer x:Name="Editor" Grid.Column="1" HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="0,0,8,16">
     <TextBlock Text="衣装" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <Button x:Name="HeadPicker" Tag="head" Click="PickAsset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" AutomationProperties.Name="あたまを画像から選ぶ">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="HeadIcon" Width="72" Height="72" Stretch="Uniform" AutomationProperties.Name="選択中のあたま"/>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="あたま" FontWeight="SemiBold"/>
       <TextBlock x:Name="HeadLabel" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="画像から選ぶ" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Grid>
    </Button>
    <Button x:Name="BodyPicker" Tag="body" Click="PickAsset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" AutomationProperties.Name="からだを画像から選ぶ">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="BodyIcon" Width="72" Height="72" Stretch="Uniform" AutomationProperties.Name="選択中のからだ"/>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="からだ" FontWeight="SemiBold"/>
       <TextBlock x:Name="BodyLabel" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="画像から選ぶ" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Grid>
    </Button>
    <Button x:Name="CostumePicker" Tag="cos" Click="PickAsset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" AutomationProperties.Name="全身きぐるみを画像から選ぶ">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="CostumeIcon" Width="72" Height="72" Stretch="Uniform" AutomationProperties.Name="選択中の全身きぐるみ"/>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="全身きぐるみ" FontWeight="SemiBold"/>
       <TextBlock x:Name="CostumeLabel" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="画像から選ぶ" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Grid>
    </Button>
    <Button x:Name="PetitCharaPicker" Tag="petit" Click="PickAsset_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12" AutomationProperties.Name="ぷちキャラを画像から選ぶ">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="PetitCharaIcon" Width="72" Height="72" Stretch="Uniform" AutomationProperties.Name="選択中のぷちキャラ"/>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
       <TextBlock Text="ぷちキャラ" FontWeight="SemiBold"/>
       <TextBlock x:Name="PetitCharaLabel" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
       <TextBlock Text="画像から選ぶ" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      </StackPanel>
     </Grid>
    </Button>
    <TextBlock Text="部位ごとの色" Style="{StaticResource SubtitleTextBlockStyle}"/>
    <Button x:Name="BodyColorButton" Tag="body" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="LimbsColorButton" Tag="limbs" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="FaceColorButton" Tag="face" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button x:Name="RimColorButton" Tag="rim" Click="Color_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
    <Button Content="色を標準に戻す" Click="ResetColors_Click"/>
    <TextBlock Text="衣装固有の模様や目・口の色は変わりません。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock Text="個別に保存していないユーザーには共通設定が適用されます。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  </ScrollViewer>
 </Grid>
</Page>