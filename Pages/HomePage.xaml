<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls"
    xmlns:local="using:TaikoDiveLauncher.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Name="HeroGradientAnimation">
            <DoubleAnimation
                Storyboard.TargetName="HeroGradientOverlay"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:16"
                AutoReverse="True"
                RepeatBehavior="Forever" />
        </Storyboard>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LayoutRoot" Padding="32,24,32,40" RowSpacing="24" SizeChanged="LayoutRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="32" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Grid
                x:Name="HeroGrid"
                Background="{ThemeResource HeroBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <Grid x:Name="HeroTextureLayer" IsHitTestVisible="False" Opacity="{ThemeResource HeroTextureOpacity}">
                    <Border x:Name="HeroBaseBorder" CornerRadius="16">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/HeroGradientA.jpg" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                    <Border x:Name="HeroGradientOverlay" CornerRadius="16" Opacity="0">
                        <Border.Background>
                            <ImageBrush ImageSource="ms-appx:///Assets/HeroGradientB.jpg" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel x:Name="HeroContent" Margin="36,32" VerticalAlignment="Center" Spacing="10">
                    <Border
                        x:Name="HeroStatusBadge"
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        Background="{ThemeResource HeroChipBackgroundBrush}"
                        BorderBrush="{ThemeResource HeroForegroundBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="HeroStatusIcon"
                                FontSize="12"
                                Foreground="{ThemeResource HeroForegroundBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                x:Name="HeroStatusText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource HeroForegroundBrush}"
                                Text="確認中" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="TaikoDive" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        FontSize="15"
                        Foreground="{ThemeResource HeroSecondaryForegroundBrush}"
                        Text="プロフィールと起動構成を整えて、ゲームを始めよう。"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="LaunchButton"
                        Margin="0,10,0,0"
                        MinHeight="52"
                        Padding="28,12"
                        AutomationProperties.Name="ゲームを起動"
                        Click="LaunchButton_Click"
                        CornerRadius="26">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E9F9FF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCEEF9" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#093F58" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#093F58" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#062F43" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#CCFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#66FFFFFF" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E9F9FF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#CCEEF9" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#093F58" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#093F58" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#062F43" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#CCFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#66FFFFFF" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE768;" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="ゲームを起動" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="1"
                IsClosable="False"
                IsOpen="False" />

            <Grid x:Name="SummaryGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryPrimaryColumn" Width="380" />
                    <ColumnDefinition x:Name="SummarySecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="CharacterSurface" Padding="16" Style="{StaticResource QuietSurfaceStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="保存済みどんちゃん（1P）" Style="{StaticResource FieldLabelStyle}" />
                        <Grid Grid.Row="1" Height="260">
                            <Ellipse
                                Width="170"
                                Height="16"
                                VerticalAlignment="Bottom"
                                Fill="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                Opacity="0.5" />
                            <Image
                                x:Name="DonPreviewImage"
                                Margin="0,0,0,8"
                                AutomationProperties.Name="保存済みの1Pどんちゃん"
                                Stretch="Uniform" />
                            <ProgressRing
                                x:Name="DonPreviewBusy"
                                Width="32"
                                Height="32"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="DonPreviewStatus"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                        <controls:NamePlateAnimationView x:Name="HomeNamePlatePreview" Grid.Row="2" />
                    </Grid>
                </Border>

                <Border x:Name="ActivitySurface" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="最近のアクティビティ" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="最近遊んだ楽曲" Style="{StaticResource FieldLabelStyle}" />
                        <ItemsControl x:Name="RecentSongsList" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RecentSongItem">
                                    <Grid
                                        Height="40"
                                        Padding="12,0"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        ColumnSpacing="14"
                                        CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="22"
                                            Height="22"
                                            Background="{ThemeResource TaikoDonBrush}"
                                            CornerRadius="11"
                                            Visibility="{x:Bind DonBadgeVisibility}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TaikoOnAccentBrush}"
                                                Text="{x:Bind RankText}" />
                                        </Border>
                                        <Border
                                            Width="22"
                                            Height="22"
                                            Background="{ThemeResource TaikoKaBrush}"
                                            CornerRadius="11"
                                            Visibility="{x:Bind KaBadgeVisibility}">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{ThemeResource TaikoOnAccentBrush}"
                                                Text="{x:Bind RankText}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            x:Name="RecentSongsEmptyText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="まだプレイ履歴がありません。"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
