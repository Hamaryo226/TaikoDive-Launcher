<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Storyboard x:Key="DonHitStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DrumTransform" Storyboard.TargetProperty="ScaleX">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="0.92" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DrumTransform" Storyboard.TargetProperty="ScaleY">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.06" Value="0.92" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation
                Storyboard.TargetName="DonRippleScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.7"
                To="1.25"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DonRippleScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.7"
                To="1.25"
                Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="DonRipple"
                Storyboard.TargetProperty="Opacity"
                From="0.9"
                To="0"
                Duration="0:0:0.45" />
        </Storyboard>

        <Storyboard x:Key="KaHitStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DrumTransform" Storyboard.TargetProperty="Rotation">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.05" Value="-7" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BackEase Amplitude="0.8" EasingMode="EaseOut" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation
                Storyboard.TargetName="KaRippleScale"
                Storyboard.TargetProperty="ScaleX"
                From="0.95"
                To="1.35"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="KaRippleScale"
                Storyboard.TargetProperty="ScaleY"
                From="0.95"
                To="1.35"
                Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="KaRipple"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.5" />
        </Storyboard>

        <Storyboard x:Key="ComboPopStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="ComboTransform"
                Storyboard.TargetProperty="ScaleX"
                From="1.3"
                To="1"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                Storyboard.TargetName="ComboTransform"
                Storyboard.TargetProperty="ScaleY"
                From="1.3"
                To="1"
                Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid x:Name="LayoutRoot" Padding="32,24,32,40" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="32" IsStaggeringEnabled="True" />
                </TransitionCollection>
            </Grid.ChildrenTransitions>

            <Grid
                x:Name="HeroGrid"
                Padding="32,28"
                Background="{ThemeResource HeroBackgroundBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="24"
                CornerRadius="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="10">
                    <Border
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        Background="{ThemeResource HeroChipBackgroundBrush}"
                        BorderBrush="{ThemeResource HeroForegroundBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="HeroStatusIcon"
                                FontSize="12"
                                Foreground="{ThemeResource HeroForegroundBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                x:Name="HeroStatusText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource HeroForegroundBrush}"
                                Text="確認中" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="TaikoDive" Style="{StaticResource HeroTitleStyle}" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Left"
                        FontSize="15"
                        Foreground="{ThemeResource HeroSecondaryForegroundBrush}"
                        Text="プロフィールと起動構成を整えたら、さあ叩こう。"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="LaunchButton"
                        Margin="0,10,0,0"
                        MinHeight="52"
                        Padding="28,12"
                        AutomationProperties.Name="ゲームを起動"
                        Click="LaunchButton_Click"
                        CornerRadius="26"
                        PointerEntered="LaunchButton_PointerEntered">
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF1EC" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE0D6" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#B02A16" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#B02A16" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8C1F0F" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#CCFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#66FFFFFF" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFF1EC" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE0D6" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40FFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="#B02A16" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#B02A16" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8C1F0F" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#CCFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#66FFFFFF" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="HighContrast">
                                        <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}" />
                                        <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}" />
                                        <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{ThemeResource SystemColorHighlightColor}" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="{ThemeResource SystemColorGrayTextColor}" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon FontSize="18" Glyph="&#xE768;" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="ゲームを起動" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        x:Name="DrumHintText"
                        FontSize="12"
                        Foreground="{ThemeResource HeroSecondaryForegroundBrush}"
                        Text="太鼓をたたいてみよう（F / J: ドン、D / K: カッ）"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ContentControl
                    x:Name="DrumArea"
                    Grid.Column="1"
                    Width="200"
                    Height="200"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="太鼓"
                    AutomationProperties.HelpText="F または J でドン、D または K でカッ"
                    CornerRadius="100"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True">
                    <Grid Width="200" Height="200">
                        <Ellipse
                            x:Name="KaRipple"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="{ThemeResource TaikoKaRippleBrush}"
                            StrokeThickness="6">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="KaRippleScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse
                            x:Name="DonRipple"
                            Width="150"
                            Height="150"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            Stroke="{ThemeResource HeroForegroundBrush}"
                            StrokeThickness="4">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="DonRippleScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Grid Width="180" Height="180" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <CompositeTransform x:Name="DrumTransform" />
                            </Grid.RenderTransform>
                            <Ellipse
                                x:Name="DrumRim"
                                Fill="{ThemeResource HeroDrumRimBrush}"
                                Stroke="{ThemeResource HeroForegroundBrush}"
                                StrokeThickness="2"
                                Tapped="DrumRim_Tapped" />
                            <Ellipse
                                x:Name="DrumFace"
                                Width="128"
                                Height="128"
                                Fill="{ThemeResource HeroDrumFaceBrush}"
                                Stroke="{ThemeResource HeroForegroundBrush}"
                                StrokeThickness="2"
                                Tapped="DrumFace_Tapped" />
                            <Ellipse
                                Width="36"
                                Height="36"
                                Fill="{ThemeResource HeroDrumCenterBrush}"
                                IsHitTestVisible="False"
                                Opacity="0.35" />
                        </Grid>
                        <TextBlock
                            x:Name="ComboText"
                            Margin="0,0,0,-8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{ThemeResource HeroForegroundBrush}"
                            IsHitTestVisible="False"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5">
                            <TextBlock.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.25" />
                            </TextBlock.OpacityTransition>
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="ComboTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </ContentControl>
            </Grid>

            <InfoBar
                x:Name="StatusBar"
                Grid.Row="1"
                IsClosable="False"
                IsOpen="False" />

            <Grid
                x:Name="QuickActionsGrid"
                Grid.Row="2"
                ColumnSpacing="12"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="QuickActionColumn3" Width="*" />
                    <ColumnDefinition x:Name="QuickActionColumn4" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button
                    x:Name="ProfilesTile"
                    Grid.Column="0"
                    controls:HoverLift.IsEnabled="True"
                    AutomationProperties.Name="プロフィール"
                    Click="QuickActionButton_Click"
                    Style="{StaticResource QuickActionTileStyle}"
                    Tag="profiles">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource TaikoDonBrush}" Style="{StaticResource QuickActionIconStyle}">
                            <FontIcon FontSize="18" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE77B;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="プロフィール" Style="{StaticResource QuickActionTitleStyle}" />
                            <TextBlock Text="名前・称号・着せ替え" Style="{StaticResource QuickActionDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    x:Name="SongsTile"
                    Grid.Column="1"
                    controls:HoverLift.IsEnabled="True"
                    AutomationProperties.Name="楽曲"
                    Click="QuickActionButton_Click"
                    Style="{StaticResource QuickActionTileStyle}"
                    Tag="songs">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource TaikoKaBrush}" Style="{StaticResource QuickActionIconStyle}">
                            <FontIcon FontSize="18" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE8D6;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="楽曲" Style="{StaticResource QuickActionTitleStyle}" />
                            <TextBlock Text="追加と並べ替え" Style="{StaticResource QuickActionDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    x:Name="InputTile"
                    Grid.Column="2"
                    controls:HoverLift.IsEnabled="True"
                    AutomationProperties.Name="入力設定"
                    Click="QuickActionButton_Click"
                    Style="{StaticResource QuickActionTileStyle}"
                    Tag="input-settings">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource TaikoDonBrush}" Style="{StaticResource QuickActionIconStyle}">
                            <FontIcon FontSize="18" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE765;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="入力設定" Style="{StaticResource QuickActionTitleStyle}" />
                            <TextBlock Text="キーとコントローラー" Style="{StaticResource QuickActionDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
                <Button
                    x:Name="LaunchSettingsTile"
                    Grid.Column="3"
                    controls:HoverLift.IsEnabled="True"
                    AutomationProperties.Name="起動構成"
                    Click="QuickActionButton_Click"
                    Style="{StaticResource QuickActionTileStyle}"
                    Tag="settings">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource TaikoKaBrush}" Style="{StaticResource QuickActionIconStyle}">
                            <FontIcon FontSize="18" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE713;" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="起動構成" Style="{StaticResource QuickActionTitleStyle}" />
                            <TextBlock Text="画面・サウンド" Style="{StaticResource QuickActionDescriptionStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <Grid x:Name="SummaryGrid" Grid.Row="3" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SummaryPrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="SummarySecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="InstallSurface" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="ゲーム" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            x:Name="InstallStateText"
                            FontWeight="SemiBold"
                            Text="未設定" />
                        <TextBlock
                            x:Name="InstallPathText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="ランチャーは TaikoDive.exe と同じフォルダーに置いて使用します。"
                            Style="{StaticResource PageSubtitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="RefreshButton"
                                Click="RefreshButton_Click"
                                Content="再確認"
                                Style="{StaticResource PrimaryButtonStyle}" />
                            <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click" Content="フォルダーを開く" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DataSurface" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="現在のデータ" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="1P プロフィール" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="PrimaryProfileText" Text="—" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="保存済みネームプレート" Style="{StaticResource FieldLabelStyle}" />
                            <controls:NamePlateAnimationView x:Name="HomeNamePlatePreview" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="保存済みどんちゃん" Style="{StaticResource FieldLabelStyle}" />
                            <Grid Height="190">
                                <Image x:Name="DonPreviewImage" Stretch="Uniform" AutomationProperties.Name="保存済みの1Pどんちゃん" />
                                <ProgressRing x:Name="DonPreviewBusy" Width="32" Height="32" IsActive="False" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock x:Name="DonPreviewStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="画面 / サウンド" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock x:Name="GameSummaryText" Text="—" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock
                            Text="編集時は元ファイルの .launcher.bak を自動作成します。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="820" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="LayoutRoot.Padding" Value="16,20,16,32" />
                            <Setter Target="HeroGrid.Padding" Value="20,20" />
                            <Setter Target="DrumArea.Visibility" Value="Collapsed" />
                            <Setter Target="DrumHintText.Visibility" Value="Collapsed" />
                            <Setter Target="QuickActionColumn3.Width" Value="0" />
                            <Setter Target="QuickActionColumn4.Width" Value="0" />
                            <Setter Target="InputTile.(Grid.Column)" Value="0" />
                            <Setter Target="InputTile.(Grid.Row)" Value="1" />
                            <Setter Target="LaunchSettingsTile.(Grid.Column)" Value="1" />
                            <Setter Target="LaunchSettingsTile.(Grid.Row)" Value="1" />
                            <Setter Target="SummaryPrimaryColumn.Width" Value="*" />
                            <Setter Target="SummarySecondaryColumn.Width" Value="0" />
                            <Setter Target="DataSurface.(Grid.Column)" Value="0" />
                            <Setter Target="DataSurface.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ScrollViewer>
</Page>
