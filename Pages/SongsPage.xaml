<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.SongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:TaikoDiveLauncher.Services"
    SizeChanged="SongsPage_SizeChanged">

    <Grid Style="{StaticResource PageLayoutStyle}" x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock x:Name="PageHeading" Text="楽曲" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="PageDescription" Text="ZIPから楽曲を追加できます。曲順や保存場所は専用画面で変更します。" Style="{StaticResource PageSubtitleStyle}" />
            <Grid x:Name="NavigationCommands" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="NavigationSecondColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="OrderNavigationButton" Click="OrderNavigationButton_Click" Style="{StaticResource EditorNavigationButtonStyle}" AutomationProperties.Name="曲順を変更する">
                    <StackPanel Spacing="4"><TextBlock Text="曲順を変更する" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="ジャンルごとの並び順を編集" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                </Button>
                <Button x:Name="FolderNavigationButton" Grid.Column="1" Click="FolderNavigationButton_Click" Style="{StaticResource EditorNavigationButtonStyle}" AutomationProperties.Name="Songsフォルダー設定">
                    <StackPanel Spacing="4"><TextBlock Text="Songsフォルダー設定" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="楽曲の保存場所を変更" Style="{StaticResource PageSubtitleStyle}"/></StackPanel>
                </Button>
            </Grid>
            <CommandBar x:Name="BackToSongsCommandBar" Style="{StaticResource PageCommandBarStyle}" HorizontalAlignment="Left" Visibility="Collapsed">
                <AppBarButton Icon="Back" Label="楽曲へ" Click="BackToSongsButton_Click" Style="{StaticResource VisibleAppBarButtonStyle}" />
            </CommandBar>
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Border
            x:Name="PathSurface"
            Grid.Row="2"
            Style="{StaticResource QuietSurfaceStyle}">
            <Grid x:Name="PathGrid" ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="現在のSongsフォルダー" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        x:Name="CurrentSongsPathText"
                        AutomationProperties.Name="現在使用中のSongsフォルダー"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="SongsPathModeText"
                        Style="{StaticResource PageSubtitleStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <CommandBar
                    x:Name="PathCommandBar"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
                    <AppBarButton Click="SelectSongsFolderButton_Click" Label="Songsを選択" Style="{StaticResource VisibleAppBarButtonStyle}">
                        <AppBarButton.Icon><SymbolIcon Symbol="Folder" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Click="FindTaikoNautsButton_Click" Label="TaikoNautsを検索" Style="{StaticResource VisibleAppBarButtonStyle}">
                        <AppBarButton.Icon><SymbolIcon Symbol="Find" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton
                        x:Name="RestoreSongsButton"
                        Click="RestoreSongsButton_Click"
                        Label="標準に戻す"
                        Style="{StaticResource VisibleAppBarButtonStyle}"
                        Visibility="Collapsed">
                        <AppBarButton.Icon><SymbolIcon Symbol="Undo" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar>
            </Grid>
        </Border>

        <ScrollViewer
            x:Name="ContentScroller"
            Grid.Row="3"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            SizeChanged="ContentScroller_SizeChanged"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled">
        <Grid x:Name="ContentGrid" ColumnSpacing="16" RowSpacing="16">
            <Border
                x:Name="DropZone"
                MinHeight="280"
                AllowDrop="True"
                AutomationProperties.Name="楽曲ZIPのドロップ領域"
                DragLeave="DropZone_DragLeave"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                Style="{StaticResource QuietSurfaceStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="楽曲ZIPを追加" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel
                        Grid.Row="1"
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="44"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE898;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="ここへドロップ"
                            TextAlignment="Center" />
                        <TextBlock
                            Text="追加先のジャンルはドロップ後に選択します。"
                            Style="{StaticResource PageSubtitleStyle}"
                            TextAlignment="Center" />
                        <Button
                            HorizontalAlignment="Center"
                            Click="SelectZipButton_Click"
                            Content="ZIPを選択"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                x:Name="OrderSurface"
                Style="{StaticResource QuietSurfaceStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="ゲーム内の曲順" Style="{StaticResource SectionTitleStyle}" />
                        <CommandBar
                            Grid.Column="1"
                            Background="Transparent"
                            DefaultLabelPosition="Collapsed">
                            <AppBarButton
                                x:Name="MoveSongUpButton"
                                Click="MoveSongUpButton_Click"
                                IsEnabled="False"
                                Label="選択した曲を上へ移動">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE70E;" /></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton
                                x:Name="MoveSongDownButton"
                                Click="MoveSongDownButton_Click"
                                IsEnabled="False"
                                Label="選択した曲を下へ移動">
                                <AppBarButton.Icon><FontIcon Glyph="&#xE70D;" /></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                    </Grid>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <ComboBox x:Name="GenreList" Header="並べ替えるジャンル" HorizontalAlignment="Stretch"
                            DisplayMemberPath="Name" SelectionChanged="GenreList_SelectionChanged"
                            PlaceholderText="ジャンルを選択してください" />
                        <TextBlock
                            x:Name="SongOrderSummaryText"
                            Style="{StaticResource PageSubtitleStyle}"
                            Text="ジャンルを選択してください。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SelectedSongText"
                            Style="{StaticResource FieldLabelStyle}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="SongOrderList"
                            MinHeight="220"
                            AllowDrop="True"
                            AutomationProperties.HelpText="曲をドラッグするか、曲を選択して上へ・下へボタンでゲーム内の順序を変更します。"
                            AutomationProperties.Name="選択したジャンルの曲順"
                            CanDragItems="True"
                            CanReorderItems="True"
                            DragItemsCompleted="SongOrderList_DragItemsCompleted"
                            SelectionChanged="SongOrderList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="services:OrderedSong">
                                    <Grid Padding="6,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="ドラッグして並べ替え"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE76F;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="EmptySongsText"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="このジャンルにTJA譜面がありません"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>
        </ScrollViewer>

        <ProgressRing
            x:Name="BusyRing"
            Grid.Row="3"
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
