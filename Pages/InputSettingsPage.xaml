<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.InputSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:TaikoDiveLauncher.Models"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="InputBindingRowTemplate" x:DataType="models:InputBindingRow">
            <Grid
                MinHeight="132"
                Padding="0,10"
                RowSpacing="8"
                AutomationProperties.Name="{x:Bind Label}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" />
                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5">
                        <TextBlock
                            Text="キーボード"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            MinHeight="34"
                            Text="{x:Bind KeyboardValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource PageSubtitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Content="キーを追加"
                                Tag="{x:Bind}"
                                Click="AddKeyboardBindingButton_Click"
                                AutomationProperties.Name="キーボードのキーを追加" />
                            <Button
                                Tag="{x:Bind}"
                                Click="RemoveKeyboardBindingButton_Click"
                                IsEnabled="{x:Bind HasKeyboardBindings, Mode=OneWay}"
                                AutomationProperties.Name="キーボード割り当てを1件削除">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock
                            Text="外部コントローラー"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            MinHeight="34"
                            Text="{x:Bind ControllerValue, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource PageSubtitleStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                Content="入力を追加"
                                Tag="{x:Bind}"
                                Click="AddControllerBindingButton_Click"
                                AutomationProperties.Name="外部コントローラー入力を追加" />
                            <Button
                                Tag="{x:Bind}"
                                Click="RemoveControllerBindingButton_Click"
                                IsEnabled="{x:Bind HasControllerBindings, Mode=OneWay}"
                                AutomationProperties.Name="外部コントローラー割り当てを1件削除">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Name="PageRoot"
        Padding="32,20,32,40"
        RowSpacing="16"
        SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="入力設定" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="TaikoDiveで叩くキーと外部コントローラー入力を割り当てます。"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Click="ReloadButton_Click" Label="再読み込み" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveButton_Click" Label="保存" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <Border Style="{StaticResource QuietSurfaceStyle}" Padding="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7FC;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="接続中のコントローラー" FontWeight="SemiBold" />
                            <TextBlock x:Name="ControllerStatusText" Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="更新" Click="RefreshControllersButton_Click" />
                    </Grid>
                </Border>

                <Grid x:Name="PlayersGrid" ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PlayerOneColumn" Width="*" />
                        <ColumnDefinition x:Name="PlayerTwoColumn" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PlayerOneSurface" Style="{StaticResource QuietSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="1P" Style="{StaticResource SectionTitleStyle}" />
                            <ListView
                                ItemsSource="{x:Bind PlayerOneRows}"
                                ItemTemplate="{StaticResource InputBindingRowTemplate}"
                                SelectionMode="None"
                                IsItemClickEnabled="False" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="PlayerTwoSurface" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="2P" Style="{StaticResource SectionTitleStyle}" />
                            <ListView
                                ItemsSource="{x:Bind PlayerTwoRows}"
                                ItemTemplate="{StaticResource InputBindingRowTemplate}"
                                SelectionMode="None"
                                IsItemClickEnabled="False" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock
                    Text="キーボードと外部コントローラーは別々に追加・削除できます。変更は保存後、次回のTaikoDive起動から反映されます。"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />

        <ContentDialog
            x:Name="CaptureDialog"
            CloseButtonText="キャンセル"
            PreviewKeyDown="CaptureDialog_KeyDown">
            <Border Padding="4">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="CaptureTargetText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="CaptureInstructionText" TextWrapping="Wrap" />
                    <ProgressRing Width="24" Height="24" IsActive="True" HorizontalAlignment="Left" />
                    <TextBlock Text="Escでキャンセル" Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </Border>
        </ContentDialog>
    </Grid>
</Page>
