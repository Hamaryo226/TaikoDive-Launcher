<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls"
    xmlns:models="using:TaikoDiveLauncher.Models">

    <Grid x:Name="PageRoot" Padding="32,20,32,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="プロフィール" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="ユーザーを選び、名前・称号・ネームプレートを編集します。" Style="{StaticResource PageSubtitleStyle}" />
                <TextBlock x:Name="EditFeedbackText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
                <controls:PageNavigationBar Margin="0,8,0,0" CurrentTag="profiles" />
            </StackPanel>
            <CommandBar
                x:Name="ProfileCommandBar"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton Click="ReloadButton_Click" Label="" Style="{StaticResource VisibleAppBarButtonStyle}" AutomationProperties.Name="再読み込み" ToolTipService.ToolTip="再読み込み">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveButton_Click" Label="保存" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Grid x:Name="EditorGrid" Grid.Row="2" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProfileColumn" Width="260" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ProfileRow" Height="*" />
                <RowDefinition x:Name="EditorRow" Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="ProfileRail" Padding="8" Style="{StaticResource QuietSurfaceStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,4" Text="プロフィール一覧" Style="{StaticResource FieldLabelStyle}" />
                    <ListBox
                        x:Name="ProfileList"
                        Grid.Row="1"
                        MinHeight="220"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        AutomationProperties.Name="ユーザープロフィール一覧"
                        SelectionChanged="ProfileList_SelectionChanged"
                        SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:UserProfile">
                                <TextBlock
                                    Padding="8,6"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind DisplayLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="EditorSurface"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <TextBlock x:Name="SlotHeading" Text="1. USER" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Spacing="12">
                        <TextBox x:Name="NameBox" Header="名前" MaxLength="32" PlaceholderText="どんちゃん" TextChanged="ProfileText_Changed" />
                        <TextBox x:Name="TitleBox" Header="称号" MaxLength="64" PlaceholderText="ドンだーデビュー" TextChanged="ProfileText_Changed" />
                        <Button Content="このユーザーの着せ替えと色を変更" Click="EditCharacter_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ネームプレート · アニメーション" Style="{StaticResource FieldLabelStyle}" />
                            <ComboBox x:Name="NamePlateBox" Header="ネームプレート" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" HorizontalAlignment="Stretch"
                                      SelectionChanged="NamePlateBox_SelectionChanged" />
                            <controls:NamePlateAnimationView x:Name="NamePlatePreview" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="保存済みスコア" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ScoreCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="ベストリプレイ" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ReplayCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="DataFolderText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PageWidthStates">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="860" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageRoot.Padding" Value="16,16,16,28" />
                            <Setter Target="ProfileCommandBar.(Grid.Column)" Value="0" />
                            <Setter Target="ProfileCommandBar.(Grid.Row)" Value="1" />
                            <Setter Target="ProfileCommandBar.HorizontalAlignment" Value="Left" />
                            <Setter Target="ProfileColumn.Width" Value="*" />
                            <Setter Target="EditorColumn.Width" Value="0" />
                            <Setter Target="ProfileRow.Height" Value="Auto" />
                            <Setter Target="EditorRow.Height" Value="*" />
                            <Setter Target="ProfileRail.MaxHeight" Value="220" />
                            <Setter Target="ProfileList.MinHeight" Value="140" />
                            <Setter Target="EditorSurface.(Grid.Column)" Value="0" />
                            <Setter Target="EditorSurface.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <ProgressRing x:Name="BusyRing" Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
    </Grid>
</Page>
