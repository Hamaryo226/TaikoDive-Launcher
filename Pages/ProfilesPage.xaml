<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,20,32,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="プロフィール" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="User.ini のユーザー名、称号、キャラクター、ネームプレートを編集します。"
                    Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Click="ReloadButton_Click" Label="再読み込み">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveButton_Click" Label="保存">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid x:Name="EditorGrid" Grid.Row="2" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView
                x:Name="ProfileList"
                MinHeight="260"
                AutomationProperties.Name="ユーザープロフィール一覧"
                DisplayMemberPath="DisplayLabel"
                SelectionChanged="ProfileList_SelectionChanged"
                SelectionMode="Single" />

            <ScrollViewer x:Name="EditorSurface" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="680" HorizontalAlignment="Left" Spacing="20">
                    <TextBlock x:Name="SlotHeading" Text="1P USER" Style="{StaticResource SectionTitleStyle}" />

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBox
                            x:Name="NameBox"
                            Header="名前"
                            MaxLength="32"
                            PlaceholderText="どんちゃん" />
                        <TextBox
                            x:Name="TitleBox"
                            Grid.Column="1"
                            Header="称号"
                            MaxLength="64"
                            PlaceholderText="ドンだーデビュー" />
                        <ComboBox
                            x:Name="CharacterBox"
                            Grid.Row="1"
                            Header="キャラクター"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value" />
                        <ComboBox
                            x:Name="NamePlateBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="ネームプレート"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value" />
                    </Grid>

                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="保存済みスコア" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ScoreCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="ベストリプレイ" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ReplayCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock
                        x:Name="DataFolderText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="860" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="ProfileList.Width" Value="Auto" />
                            <Setter Target="ProfileList.MaxHeight" Value="240" />
                            <Setter Target="EditorSurface.(Grid.Column)" Value="0" />
                            <Setter Target="EditorSurface.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <ProgressRing
            x:Name="BusyRing"
            Grid.Row="2"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
