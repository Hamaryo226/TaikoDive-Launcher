<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls"
    xmlns:models="using:TaikoDiveLauncher.Models">

    <Grid Style="{StaticResource PageLayoutStyle}" x:Name="PageRoot" SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="プロフィール" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="ユーザーを選び、保存済みの見た目を確認できます。" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <ScrollViewer
            x:Name="PageScroller"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
        <Grid x:Name="EditorGrid" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProfileColumn" Width="260" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ProfileRow" Height="*" />
                <RowDefinition x:Name="EditorRow" Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="ProfileRail" Padding="8" Style="{StaticResource QuietSurfaceStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,4" Text="プロフィール一覧" Style="{StaticResource FieldLabelStyle}" />
                    <ListView
                        x:Name="ProfileList"
                        Grid.Row="1"
                        MinHeight="220"
                        Background="Transparent"
                        AutomationProperties.Name="ユーザープロフィール一覧"
                        SelectionChanged="ProfileList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.Resources>
                            <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:UserProfile">
                                <TextBlock
                                    Padding="8,6"
                                    Text="{x:Bind DisplayLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="EditorSurface" HorizontalContentAlignment="Stretch"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <StackPanel Spacing="8" MaxWidth="480" HorizontalAlignment="Stretch">
                        <controls:NamePlateAnimationView x:Name="NamePlatePreview" MaxWidth="400" HorizontalAlignment="Stretch" />
                        <Grid Height="300">
                            <Image x:Name="DonPreviewImage" Stretch="Uniform" AutomationProperties.Name="選択中のユーザーの保存済みどんちゃん" />
                            <ProgressRing x:Name="PreviewBusy" Width="32" Height="32" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                    <Grid x:Name="EditActions" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ActionColumn" Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="CharacterNavigationButton" AutomationProperties.Name="着せ替えを編集" Click="EditCharacter_Click" Style="{StaticResource EditorNavigationButtonStyle}">
                            <StackPanel Spacing="4"><TextBlock Text="着せ替えを編集" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="衣装・パーツ・色" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        </Button>
                        <Button x:Name="NamePlateNavigationButton" AutomationProperties.Name="ネームプレートを編集" Grid.Column="1" Click="EditNamePlate_Click" Style="{StaticResource EditorNavigationButtonStyle}">
                            <StackPanel Spacing="4"><TextBlock Text="ネームプレートを編集" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="名前・称号・デザイン" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </ScrollViewer>

        <ProgressRing x:Name="BusyRing" Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
    </Grid>
</Page>
