<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls">

    <Grid x:Name="PageRoot" Padding="32,20,32,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="プロフィール" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="ユーザーを選び、名前・称号・キャラクター・ネームプレートを編集します。" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>
            <CommandBar
                x:Name="ProfileCommandBar"
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton Click="ReloadButton_Click" Label="再読み込み" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon><SymbolIcon Symbol="Refresh" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="SaveButton_Click" Label="保存" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon><SymbolIcon Symbol="Save" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Grid x:Name="EditorGrid" Grid.Row="2" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProfileColumn" Width="260" />
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ProfileRow" Height="*" />
                <RowDefinition x:Name="EditorRow" Height="0" />
            </Grid.RowDefinitions>

            <Border x:Name="ProfileRail" Padding="8" Style="{StaticResource QuietSurfaceStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="8,4" Text="プロフィール一覧" Style="{StaticResource FieldLabelStyle}" />
                    <ListView
                        x:Name="ProfileList"
                        Grid.Row="1"
                        MinHeight="220"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        AutomationProperties.Name="ユーザープロフィール一覧"
                        SelectionChanged="ProfileList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Padding="8,6"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding DisplayLabel}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="EditorSurface"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Spacing="20">
                    <TextBlock x:Name="SlotHeading" Text="1P USER" Style="{StaticResource SectionTitleStyle}" />

                    <Grid x:Name="ProfileForm" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="FormPrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="FormSecondaryColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="NameBox" Header="名前" MaxLength="32" PlaceholderText="どんちゃん" />
                        <TextBox x:Name="TitleBox" Grid.Column="1" Header="称号" MaxLength="64" PlaceholderText="ドンだーデビュー" />
                        <ComboBox
                            x:Name="CharacterBox"
                            Grid.Row="1"
                            Header="キャラクター"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectionChanged="CharacterBox_SelectionChanged" />
                        <ComboBox
                            x:Name="NamePlateBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Header="ネームプレート"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value"
                            SelectionChanged="NamePlateBox_SelectionChanged" />
                    </Grid>

                    <Grid x:Name="PreviewGrid" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="PreviewPrimaryColumn" Width="*" />
                            <ColumnDefinition x:Name="PreviewSecondaryColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource QuietSurfaceStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="キャラクター · normal" Style="{StaticResource FieldLabelStyle}" />
                                <controls:CharacterAnimationView x:Name="CharacterPreview" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NamePlatePreviewSurface" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="ネームプレート · アニメーション" Style="{StaticResource FieldLabelStyle}" />
                                <controls:NamePlateAnimationView x:Name="NamePlatePreview" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource QuietSurfaceStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="保存済みスコア" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ScoreCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="ベストリプレイ" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock x:Name="ReplayCountText" FontSize="24" FontWeight="SemiBold" Text="—" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="DataFolderText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PageWidthStates">
                    <VisualState x:Name="WideState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="860" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="NarrowState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageRoot.Padding" Value="16,16,16,28" />
                            <Setter Target="ProfileCommandBar.(Grid.Column)" Value="0" />
                            <Setter Target="ProfileCommandBar.(Grid.Row)" Value="1" />
                            <Setter Target="ProfileCommandBar.HorizontalAlignment" Value="Left" />
                            <Setter Target="ProfileColumn.Width" Value="*" />
                            <Setter Target="EditorColumn.Width" Value="0" />
                            <Setter Target="ProfileRow.Height" Value="Auto" />
                            <Setter Target="EditorRow.Height" Value="*" />
                            <Setter Target="ProfileRail.MaxHeight" Value="220" />
                            <Setter Target="ProfileList.MinHeight" Value="140" />
                            <Setter Target="EditorSurface.(Grid.Column)" Value="0" />
                            <Setter Target="EditorSurface.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="FormWidthStates">
                    <VisualState x:Name="FormWideState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="660" /></VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="FormNarrowState">
                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="FormPrimaryColumn.Width" Value="*" />
                            <Setter Target="FormSecondaryColumn.Width" Value="0" />
                            <Setter Target="TitleBox.(Grid.Column)" Value="0" />
                            <Setter Target="TitleBox.(Grid.Row)" Value="1" />
                            <Setter Target="CharacterBox.(Grid.Row)" Value="2" />
                            <Setter Target="NamePlateBox.(Grid.Column)" Value="0" />
                            <Setter Target="NamePlateBox.(Grid.Row)" Value="3" />
                            <Setter Target="PreviewPrimaryColumn.Width" Value="*" />
                            <Setter Target="PreviewSecondaryColumn.Width" Value="0" />
                            <Setter Target="NamePlatePreviewSurface.(Grid.Column)" Value="0" />
                            <Setter Target="NamePlatePreviewSurface.(Grid.Row)" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <ProgressRing x:Name="BusyRing" Grid.Row="2" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
    </Grid>
</Page>
