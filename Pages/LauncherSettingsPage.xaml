<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.LauncherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="32,20,32,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="ランチャー設定" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="表示テーマとTaikoDive起動後の動作を設定します。" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">
                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="テーマ" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock
                                Text="アイコンを押すとホワイトモードとダークモードが切り替わります。"
                                Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="ThemeToggleButton"
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ThemeToggleButton_Click"
                            ToolTipService.ToolTip="テーマを切り替え">
                            <FontIcon x:Name="ThemeIcon" FontSize="20" />
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="起動動作" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch
                            x:Name="CloseAfterLaunchSwitch"
                            Header="TaikoDive起動後にランチャーを終了"
                            Toggled="CloseAfterLaunchSwitch_Toggled" />
                        <TextBlock
                            Text="有効にすると、ゲーム中にランチャーが常駐しません。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="ランチャーのアップデート" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Text="起動時にバックグラウンドでmainブランチの最新版を確認します。"
                            Style="{StaticResource PageSubtitleStyle}" />
                        <TextBlock x:Name="CurrentVersionText" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing
                                x:Name="UpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False" />
                            <TextBlock
                                x:Name="UpdateStatusText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CheckUpdateButton"
                                Click="CheckUpdateButton_Click"
                                Content="今すぐ確認" />
                            <Button
                                x:Name="InstallUpdateButton"
                                Click="InstallUpdateButton_Click"
                                Content="アップデート"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="TaikoDiveのアップデート" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Text="配布情報とSHA-256を検証し、暗号化された公式パッケージからゲーム本体とアセットを更新します。設定、プロフィール、Songs、スコア、リプレイは変更しません。"
                            Style="{StaticResource PageSubtitleStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock x:Name="CurrentGameVersionText" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing
                                x:Name="GameUpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False" />
                            <TextBlock
                                x:Name="GameUpdateStatusText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="CheckGameUpdateButton"
                                Click="CheckGameUpdateButton_Click"
                                Content="今すぐ確認" />
                            <Button
                                x:Name="InstallGameUpdateButton"
                                Click="InstallGameUpdateButton_Click"
                                Content="TaikoDiveを更新"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="700" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16,16,16,28" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
