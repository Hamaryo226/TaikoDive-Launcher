<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.LauncherSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="PageRoot" Padding="32,20,32,40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock Text="ランチャー設定" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="表示テーマとTaikoDive起動後の動作を設定します。" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <InfoBar x:Name="StatusBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">
                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="テーマ" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock
                                Text="アイコンを押すとホワイトモードとダークモードが切り替わります。"
                                Style="{StaticResource PageSubtitleStyle}" />
                        </StackPanel>
                        <Button
                            x:Name="ThemeToggleButton"
                            Grid.Column="1"
                            Width="48"
                            Height="48"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="ThemeToggleButton_Click"
                            ToolTipService.ToolTip="テーマを切り替え">
                            <FontIcon x:Name="ThemeIcon" FontSize="20" />
                        </Button>
                    </Grid>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="起動動作" Style="{StaticResource SectionTitleStyle}" />
                        <ToggleSwitch
                            x:Name="CloseAfterLaunchSwitch"
                            Header="TaikoDive起動後にランチャーを終了"
                            Toggled="CloseAfterLaunchSwitch_Toggled" />
                        <TextBlock
                            Text="有効にすると、ゲーム中にランチャーが常駐しません。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UpdateCardIconStyle}">
                                <SymbolIcon Symbol="Sync" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="ランチャー" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="CurrentVersionText" Style="{StaticResource UpdateVersionStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="UpdateAvailableBadge"
                                Grid.Column="2"
                                Style="{StaticResource UpdateAvailableBadgeStyle}"
                                Visibility="Collapsed">
                                <TextBlock Text="更新あり" Style="{StaticResource UpdateAvailableBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Text="起動時にバックグラウンドでmainブランチの最新版を確認します。"
                            Style="{StaticResource PageSubtitleStyle}" />
                        <Grid MinHeight="24" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                x:Name="UpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <SymbolIcon
                                x:Name="UpdateStatusIcon"
                                Width="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Help" />
                            <TextBlock
                                x:Name="UpdateStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid x:Name="UpdateProgressPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="UpdateProgressBar"
                                Height="4"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="UpdateProgressText"
                                Grid.Column="1"
                                MinWidth="36"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CheckUpdateButton"
                                Click="CheckUpdateButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="更新を確認" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="InstallUpdateButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Click="InstallUpdateButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="ランチャーを更新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UpdateCardIconStyle}">
                                <SymbolIcon Symbol="Play" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="TaikoDive" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="CurrentGameVersionText" Style="{StaticResource UpdateVersionStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="GameUpdateAvailableBadge"
                                Grid.Column="2"
                                Style="{StaticResource UpdateAvailableBadgeStyle}"
                                Visibility="Collapsed">
                                <TextBlock Text="更新あり" Style="{StaticResource UpdateAvailableBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Text="配布情報とSHA-256を検証し、暗号化された公式パッケージからゲーム本体を更新します。設定、プロフィール、Songs、スコア、リプレイは変更しません。"
                            Style="{StaticResource PageSubtitleStyle}"
                            TextWrapping="Wrap" />
                        <Grid MinHeight="24" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                x:Name="GameUpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <SymbolIcon
                                x:Name="GameUpdateStatusIcon"
                                Width="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Help" />
                            <TextBlock
                                x:Name="GameUpdateStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid x:Name="GameUpdateProgressPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="GameUpdateProgressBar"
                                Height="4"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="GameUpdateProgressText"
                                Grid.Column="1"
                                MinWidth="36"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CheckGameUpdateButton"
                                Click="CheckGameUpdateButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="更新を確認" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="InstallGameUpdateButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Click="InstallGameUpdateButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="TaikoDiveを更新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource UpdateCardIconStyle}">
                                <SymbolIcon Symbol="Pictures" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="TaikoDive Asset" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="CurrentAssetVersionText" Style="{StaticResource UpdateVersionStyle}" />
                            </StackPanel>
                            <Border
                                x:Name="AssetUpdateAvailableBadge"
                                Grid.Column="2"
                                Style="{StaticResource UpdateAvailableBadgeStyle}"
                                Visibility="Collapsed">
                                <TextBlock Text="更新あり" Style="{StaticResource UpdateAvailableBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Text="privateの公式Assetリポジトリで配布されたsrcの内容を、検証後にゲームのbuildフォルダーへ適用します。Info/User.iniなどのユーザーデータは変更しません。"
                            Style="{StaticResource PageSubtitleStyle}"
                            TextWrapping="Wrap" />
                        <Grid MinHeight="24" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                x:Name="AssetUpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <SymbolIcon
                                x:Name="AssetUpdateStatusIcon"
                                Width="20"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Symbol="Help" />
                            <TextBlock
                                x:Name="AssetUpdateStatusText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap" />
                        </Grid>
                        <Grid x:Name="AssetUpdateProgressPanel" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar
                                x:Name="AssetUpdateProgressBar"
                                Height="4"
                                Minimum="0"
                                Maximum="100"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="AssetUpdateProgressText"
                                Grid.Column="1"
                                MinWidth="36"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Right" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CheckAssetUpdateButton"
                                Click="CheckAssetUpdateButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Refresh" />
                                    <TextBlock Text="更新を確認" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="InstallAssetUpdateButton"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Click="InstallAssetUpdateButton_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="Assetを更新" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="700" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="16,16,16,28" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
