<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.Pages.LaunchSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" Padding="32,20,32,40" RowSpacing="16" SizeChanged="PageRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderGrid" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="起動構成" Style="{StaticResource PageTitleStyle}" />
                <TextBlock
                    Text="TaikoDiveの画面・サウンド・読み込み設定を編集します。"
                    Style="{StaticResource PageSubtitleStyle}" />
                <TextBlock x:Name="LiveSettingsSummaryText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <CommandBar x:Name="SaveCommandBar" Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Click="SaveButton_Click" Label="保存" Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Save" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Click="ReloadButton_Click" Label="保存済みを再読み込み" />
                </CommandBar.SecondaryCommands>
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SettingsGrid" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsPrimaryColumn" Width="*" />
                    <ColumnDefinition x:Name="SettingsSecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="WindowSurface" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="画面" Style="{StaticResource SectionTitleStyle}" />
                        <ComboBox
                            x:Name="ResolutionBox"
                            Header="ウィンドウ解像度"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Width" />
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="フルスクリーン" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="FullScreenSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="フルスクリーン" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ボーダーレスウィンドウ" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="BorderlessSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="ボーダーレスウィンドウ" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="垂直同期" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="VerticalSyncSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="垂直同期" />
                        </Grid>
                        <ComboBox
                            x:Name="BackgroundMovieLayoutBox"
                            Header="背景ムービーの表示"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value" />
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="タイトル画面を表示" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="TitleShowSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="タイトル画面を表示" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ゲストモード" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="GuestModeSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="ゲストモード" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="2人プレイ" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="TwoPlayerModeSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="2人プレイ" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ベストリプレイを保存" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="SaveReplaySwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="ベストリプレイを保存" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="フリープレイ" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="FreePlaySwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="フリープレイ" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="コラボ背景を表示" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="CollaboBackSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="コラボ背景を表示" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="AudioSurface" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="サウンド" Style="{StaticResource SectionTitleStyle}" />
                        <Slider x:Name="MasterVolumeSlider" Header="マスター音量" Minimum="0" Maximum="100" StepFrequency="1" />
                        <Slider x:Name="MusicVolumeSlider" Header="楽曲音量" Minimum="0" Maximum="100" StepFrequency="1" />
                        <Slider x:Name="SoundEffectVolumeSlider" Header="効果音音量" Minimum="0" Maximum="100" StepFrequency="1" />
                        <ComboBox x:Name="SoundTypeBox" Header="出力方式" />
                        <NumberBox
                            x:Name="SoundBufferBox"
                            Header="バッファサンプル数（0 = 自動）"
                            Minimum="0"
                            Maximum="8192"
                            SmallChange="32"
                            SpinButtonPlacementMode="Compact" />
                    </StackPanel>
                </Border>

                <Border x:Name="PerformanceSurface" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="メモリ / 読み込み" Style="{StaticResource SectionTitleStyle}" />
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="楽曲音声を圧縮したまま保持" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="CompressedSoundSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="楽曲音声を圧縮したまま保持" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="一般テクスチャを16bit化" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="Texture16BitSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="一般テクスチャを16bit化" />
                        </Grid>
                        <Grid MinHeight="40" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="背景テクスチャを16bit化" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ToggleSwitch x:Name="BgTexture16BitSwitch" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="背景テクスチャを16bit化" />
                        </Grid>
                        <TextBlock
                            Text="16bit化はRAMを節約しますが、グラデーションや白いキャラの色に差が出る場合があります。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="FontSurface" Grid.Row="2" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="フォント" Style="{StaticResource SectionTitleStyle}" />
                        <TextBox x:Name="FontOedoBox" Header="大江戸勘亭流" />
                        <TextBox x:Name="FontDFGothicBox" Header="太丸ゴシック" />
                        <TextBox x:Name="FontSeuratBox" Header="スーラ" />
                        <TextBox x:Name="FontDomCasualBox" Header="Dom Casual" />
                        <TextBox x:Name="FontFallbackBox" Header="フォールバック" />
                        <TextBlock
                            Text="ゲームで使用するフォントファミリー名を指定します。変更は次回起動から反映されます。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="OnlineSurface" Grid.Row="2" Grid.Column="1" Style="{StaticResource QuietSurfaceStyle}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="オンライン" Style="{StaticResource SectionTitleStyle}" />
                        <NumberBox
                            x:Name="OnlinePortBox"
                            Header="接続ポート"
                            Minimum="1"
                            Maximum="65535"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact" />
                        <TextBox
                            x:Name="LastJoinAddressBox"
                            Header="最後に接続したアドレス"
                            PlaceholderText="例: 192.0.2.1:22047" />
                        <TextBlock
                            Text="アドレスはオンラインロビーで接続先の初期値として使われます。"
                            Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ProgressRing
            x:Name="BusyRing"
            Grid.Row="2"
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</Page>
