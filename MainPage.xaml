<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1040"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Auto"
        SelectionChanged="ShellNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="ホーム" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="プロフィール" Tag="profiles">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="楽曲" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="起動構成" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar
                x:Name="ShellCommandBar"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton
                    x:Name="ThemeButton"
                    Click="ThemeButton_Click"
                    Label="ダーク"
                    Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE706;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    Click="LaunchButton_Click"
                    Label="TaikoDive を起動"
                    Style="{StaticResource VisibleAppBarButtonStyle}">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Play" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.Content>
                    <TextBlock
                        x:Name="InstallStatusText"
                        MaxWidth="560"
                        Margin="8,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                </CommandBar.Content>
            </CommandBar>

            <Frame x:Name="ContentFrame" Grid.Row="1" />

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="ShellWideState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="760" />
                        </VisualState.StateTriggers>
                    </VisualState>
                    <VisualState x:Name="ShellNarrowState">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="InstallStatusText.Visibility" Value="Collapsed" />
                            <Setter Target="ShellCommandBar.DefaultLabelPosition" Value="Collapsed" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </NavigationView>
</Page>
