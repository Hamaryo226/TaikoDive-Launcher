<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TaikoDiveLauncher.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="ShellNavigation"
        AlwaysShowHeader="False"
        CompactModeThresholdWidth="720"
        ExpandedModeThresholdWidth="1040"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="180"
        PaneDisplayMode="Auto"
        SelectionChanged="ShellNavigation_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeItem" Content="ホーム" Tag="home">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="プロフィール" Tag="profiles">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Contact" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="楽曲" Tag="songs">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8D6;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="入力設定" Tag="input-settings">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE765;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="起動構成" Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="LauncherSettingsItem" Content="ランチャー設定" Tag="launcher-settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                x:Name="UpdateBanner"
                Margin="12,8,12,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational"
                Title="ランチャーのアップデート">
                <InfoBar.ActionButton>
                    <Button Click="OpenUpdateSettingsButton_Click" Content="設定を開く" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Frame
                x:Name="ContentFrame"
                Grid.Row="1"
                CacheSize="0"
                IsNavigationStackEnabled="False" />
        </Grid>
    </NavigationView>
</Page>
