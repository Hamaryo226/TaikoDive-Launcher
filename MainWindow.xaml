<Window x:Class="TaikoDiveLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaikoDive Launcher"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="550"
        WindowStyle="None"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" CornerRadius="16" Background="{StaticResource BgGradient}"
            BorderBrush="#222236" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- サイドバー -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="#111119" CornerRadius="16,0,0,16"
                    BorderBrush="#222236" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- タイトルエリア（ドラッグ可能） -->
                    <StackPanel Grid.Row="0" Margin="20,20,20,24" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock FontSize="22" FontWeight="Bold" Margin="0,0,0,2"
                                   FontFamily="Segoe UI">
                            <Run Text="Taiko" Foreground="{StaticResource AccentOrangeBrush}"/><Run Text="Dive" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </TextBlock>
                        <TextBlock Text="Launcher" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Segoe UI"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- ナビゲーションメニュー -->
                    <StackPanel Grid.Row="1" Margin="8,0">
                        <Button x:Name="BtnHome" Content="ホーム" Style="{StaticResource NavButton}"
                                Click="BtnHome_Click"/>
                        <Button x:Name="BtnSettings" Content="設定" Style="{StaticResource NavButton}"
                                Click="BtnSettings_Click"/>
                        <Button x:Name="BtnPlayerData" Content="プレイヤー" Style="{StaticResource NavButton}"
                                Click="BtnPlayerData_Click"/>
                        <Button x:Name="BtnScoreViewer" Content="📊 スコア記録" Style="{StaticResource NavButton}"
                                Click="BtnScoreViewer_Click"/>

                        <!-- 区切り線 -->
                        <Border Height="1" Background="#222236" Margin="8,12" Opacity="0.6"/>

                        <Button x:Name="BtnLauncherSettings" Content="⚙ ランチャー設定" Style="{StaticResource NavButton}"
                                Click="BtnLauncherSettings_Click"/>
                    </StackPanel>

                    <!-- ウィンドウコントロール -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button Content="─" Style="{StaticResource ModernButton}" Width="36" Height="36"
                                Padding="0" FontSize="16" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Style="{StaticResource ModernButton}" Width="36" Height="36"
                                Padding="0" FontSize="14" Margin="8,0,0,0" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- メインコンテンツエリア -->
            <Grid Grid.Column="1">
                <!-- ホーム画面 -->
                <Grid x:Name="HomePage" Visibility="Visible" MouseMove="HomePage_MouseMove"
                      MouseLeave="HomePage_MouseLeave"
                      Background="Transparent" ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- グリッドライン装飾（Vercel風） -->
                    <Canvas Grid.Row="0" IsHitTestVisible="False" Opacity="0.06">
                        <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Left="120"/>
                        <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Left="240"/>
                        <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Left="360"/>
                        <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Left="480"/>
                        <Line X1="0" Y1="0" X2="0" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Left="600"/>
                        <Line X1="0" Y1="2000" X2="2000" Y2="2000" Stroke="White" StrokeThickness="1"
                              Canvas.Top="120"/>
                        <Line X1="0" Y1="0" X2="2000" Y2="0" Stroke="White" StrokeThickness="1"
                              Canvas.Top="240"/>
                        <Line X1="0" Y1="0" X2="2000" Y2="0" Stroke="White" StrokeThickness="1"
                              Canvas.Top="360"/>
                    </Canvas>

                    <!-- マウス追従グローエフェクト -->
                    <Canvas Grid.Row="0" IsHitTestVisible="False" ClipToBounds="True">
                        <Ellipse x:Name="GlowOrb" Width="500" Height="500" IsHitTestVisible="False"
                                 Opacity="0.15" Canvas.Left="-250" Canvas.Top="-250">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#06D6A0" Offset="0"/>
                                    <GradientStop Color="#7B68EE" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- セカンダリグロー -->
                        <Ellipse x:Name="GlowOrb2" Width="300" Height="300" IsHitTestVisible="False"
                                 Opacity="0.08" Canvas.Left="-150" Canvas.Top="-150">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#7B68EE" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Canvas>

                    <!-- ヒーローコンテンツ -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                IsHitTestVisible="True">
                        <TextBlock FontSize="48" FontWeight="Bold"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI"
                                   Margin="0,0,0,8">
                            <Run Text="Taiko" Foreground="{StaticResource AccentOrangeBrush}"/><Run Text="Dive" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </TextBlock>
                        <TextBlock Text="With DxLib" FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,32"
                                   FontFamily="Segoe UI"/>

                        <Button Content="ゲームを起動" Style="{StaticResource AccentButton}"
                                Click="BtnLaunchGame_Click" FontSize="18" Padding="48,16"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ステータスバー -->
                    <Border x:Name="StatusBarBorder" Grid.Row="1" Background="#111119" Padding="20,12" CornerRadius="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4ADE80" Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtStatus" Text="準備完了" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 設定画面コンテナ -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="32,24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsContent"/>
                </ScrollViewer>

                <!-- プレイヤーデータ画面コンテナ -->
                <ScrollViewer x:Name="PlayerDataPage" Visibility="Collapsed" Padding="32,24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PlayerDataContent"/>
                </ScrollViewer>

                <!-- スコア記録画面コンテナ -->
                <ScrollViewer x:Name="ScoreViewerPage" Visibility="Collapsed" Padding="32,24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ScoreViewerContent"/>
                </ScrollViewer>

                <!-- ランチャー設定画面コンテナ -->
                <ScrollViewer x:Name="LauncherSettingsPage" Visibility="Collapsed" Padding="32,24"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LauncherSettingsContent"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
