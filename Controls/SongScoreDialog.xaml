<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TaikoDiveLauncher.Controls.SongScoreDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TaikoDiveLauncher.Controls"
    CloseButtonText="閉じる"
    DefaultButton="Close"
    Opened="Dialog_Opened"
    Closed="Dialog_Closed">
    <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Padding="0,0,20,0">
        <StackPanel x:Name="DialogContent" Spacing="20" SizeChanged="DialogContent_SizeChanged">
            <StackPanel Spacing="8">
                <TextBlock Text="難易度別の自己ベスト" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                <GridView
                    x:Name="DifficultyList"
                    SelectionMode="Single"
                    SelectionChanged="DifficultyList_SelectionChanged"
                    ContainerContentChanging="DifficultyList_ContainerContentChanging"
                    IsItemClickEnabled="False"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    AutomationProperties.Name="記録を表示する難易度">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid x:Name="DifficultyPanel" Orientation="Horizontal" MaximumRowsOrColumns="5" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="4,8" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:SongDifficultyItem">
                            <StackPanel Spacing="4" ToolTipService.ToolTip="{x:Bind Description}">
                                <TextBlock Text="{x:Bind ShortName}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" />
                                <StackPanel Height="24" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                    <Image Source="{x:Bind CrownImage}" Width="24" Height="24" Stretch="Uniform" Visibility="{x:Bind ImageVisibility}" />
                                    <TextBlock Text="{x:Bind CrownFallback}" TextAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind FallbackVisibility}" />
                                    <TextBlock Text="{x:Bind RankText}" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ScoreText}" FontSize="11" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>

            <Grid x:Name="ScoreSummary" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SelectedDifficultyText" FontSize="18" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="BestScoreText" FontSize="32" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScoreUnitText" Text="点" VerticalAlignment="Bottom" Margin="0,0,0,6" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="CrownSummary" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image x:Name="SelectedCrownImage" Width="40" Height="40" Stretch="Uniform" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="CrownText" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScoreRankText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid>
                <InfoBar x:Name="EmptyRecordBar" Severity="Informational" IsClosable="False" IsOpen="False"
                         Message="この難易度の記録はまだありません。" />

                <StackPanel x:Name="BreakdownPanel" Spacing="14">
                    <TextBlock Text="自己ベスト時の内訳" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                    <Grid ColumnSpacing="16" RowSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="良" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="GreatText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="可" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="GoodText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="不可" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="MissText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="連打" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="RollText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="最大コンボ" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ComboText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <TextBlock Text="ゲージ" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="GaugeText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="GaugeBar" Minimum="0" Maximum="100" AutomationProperties.Name="自己ベスト時のゲージ" />
                    <TextBlock Text="内訳は最高スコアを記録したときの成績です。王冠とスコアランクは、それぞれ最高到達記録を表示しています。"
                               FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
