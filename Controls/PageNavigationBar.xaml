<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="TaikoDiveLauncher.Controls.PageNavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TaikoDiveLauncher.Controls">

    <VariableSizedWrapGrid
        x:Name="ButtonsPanel"
        AutomationProperties.Name="ほかのページへ"
        ItemHeight="52"
        ItemWidth="156"
        Orientation="Horizontal">
        <Button
            controls:HoverLift.IsEnabled="True"
            AutomationProperties.Name="ホーム"
            Click="NavigationButton_Click"
            Style="{StaticResource PageNavigationButtonStyle}"
            Tag="home">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource TaikoDonBrush}" Style="{StaticResource PageNavigationIconStyle}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE80F;" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="ホーム" />
            </StackPanel>
        </Button>
        <Button
            controls:HoverLift.IsEnabled="True"
            AutomationProperties.Name="プロフィール"
            Click="NavigationButton_Click"
            Style="{StaticResource PageNavigationButtonStyle}"
            Tag="profiles">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource TaikoKaBrush}" Style="{StaticResource PageNavigationIconStyle}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE77B;" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="プロフィール" />
            </StackPanel>
        </Button>
        <Button
            controls:HoverLift.IsEnabled="True"
            AutomationProperties.Name="楽曲"
            Click="NavigationButton_Click"
            Style="{StaticResource PageNavigationButtonStyle}"
            Tag="songs">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource TaikoDonBrush}" Style="{StaticResource PageNavigationIconStyle}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE8D6;" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="楽曲" />
            </StackPanel>
        </Button>
        <Button
            controls:HoverLift.IsEnabled="True"
            AutomationProperties.Name="入力設定"
            Click="NavigationButton_Click"
            Style="{StaticResource PageNavigationButtonStyle}"
            Tag="input-settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource TaikoKaBrush}" Style="{StaticResource PageNavigationIconStyle}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE765;" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="入力設定" />
            </StackPanel>
        </Button>
        <Button
            controls:HoverLift.IsEnabled="True"
            AutomationProperties.Name="起動構成"
            Click="NavigationButton_Click"
            Style="{StaticResource PageNavigationButtonStyle}"
            Tag="settings">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Background="{ThemeResource TaikoDonBrush}" Style="{StaticResource PageNavigationIconStyle}">
                    <FontIcon FontSize="14" Foreground="{ThemeResource TaikoOnAccentBrush}" Glyph="&#xE713;" />
                </Border>
                <TextBlock VerticalAlignment="Center" Text="起動構成" />
            </StackPanel>
        </Button>
    </VariableSizedWrapGrid>
</UserControl>
